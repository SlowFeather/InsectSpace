INSECTSPACE_MYSQL_CONNECTION=Server=127.0.0.1;Port=3306;Database=insectspace;User ID=insectspace_local;Password=replace-me;SslMode=None;AllowPublicKeyRetrieval=True
INSECTSPACE_REDIS_CONNECTION=127.0.0.1:6379,abortConnect=false
INSECTSPACE_SESSION_SIGNING_KEY=replace-with-at-least-32-random-characters
INSECTSPACE_PHONE_AUTH_MODE=test
# Comma-separated E.164 numbers. Whitelisted phones may log in with a null/empty code.
INSECTSPACE_PHONE_WHITELIST=
