        <mxCell id="killer-edge-4" edge="1" parent="1" source="killer-import-edit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#69818A;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="killer-import-finish" value="确认">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="killer-validation-note" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#263238;strokeColor=#8C9AA1;strokeWidth=1.2;align=center;verticalAlign=middle;spacing=8;fillColor=#F2F4F5;align=left;fontSize=16;" value="保存与培养校验&#xa;已满 8 招：选择替换目标并确认，或取消。&#xa;不识别的码 / 版本过期：显示原因，原配置不动。&#xa;资源不足：提示缺口，允许取消且不扣费。&#xa;提交中禁重复操作；未知结果先查询。&#xa;生效配置与伤害、资源扣取由服务器确认。" vertex="1">
          <mxGeometry height="182" width="500" x="1260" y="906" as="geometry" />
        </mxCell>
        <mxCell id="killer-damage-note" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#263238;strokeColor=#8C9AA1;strokeWidth=1.2;align=center;verticalAlign=middle;spacing=8;fillColor=#FFFFFF;align=left;fontSize=16;" value="伤害预览口径&#xa;角色属性、道痕与目标条件保持一致后比较。&#xa;不把目标不同造成的变化误写成等级成长。&#xa;示例 180 → 198 仅演示差值，不是正式公式。&#xa;角色页显示最终杀招配置，返回保留选中招式。" vertex="1">
          <mxGeometry height="142" width="500" x="1260" y="1124" as="geometry" />
