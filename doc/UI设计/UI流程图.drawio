        </mxCell>
        <mxCell id="dao-training" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#263238;strokeColor=#8C9AA1;strokeWidth=1.2;align=center;verticalAlign=middle;spacing=8;fillColor=#FFFFFF;" value="提交修炼 → 显示修炼中&#xa;不先扣本地显示值，不重复提交" vertex="1">
