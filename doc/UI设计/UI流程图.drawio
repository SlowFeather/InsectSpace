        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="inventory-title" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#263238;strokeColor=#8C9AA1;strokeWidth=1.2;align=center;verticalAlign=middle;spacing=8;fillColor=#FFFFFF;strokeColor=none;fillColor=none;align=left;spacing=0;fontSize=29;" value="07  背包 · 分类与物品操作" vertex="1">
