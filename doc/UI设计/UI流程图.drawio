        <mxCell id="inventory-inventory-tip" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#263238;strokeColor=#8C9AA1;strokeWidth=1.2;align=center;verticalAlign=middle;spacing=8;fillColor=#FFFFFF;strokeColor=none;fillColor=none;align=left;spacing=0;fontSize=13;" value="物品操作随分类与状态变化" vertex="1">
          <mxGeometry height="22" width="512" x="664" y="1176" as="geometry" />
        </mxCell>
        <mxCell id="inventory-left-title" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#263238;strokeColor=#8C9AA1;strokeWidth=1.2;align=center;verticalAlign=middle;spacing=8;fillColor=#FFFFFF;strokeColor=none;fillColor=none;align=left;spacing=0;fontSize=22;" value="分类与收纳" vertex="1">
          <mxGeometry height="30" width="510" x="40" y="160" as="geometry" />
        </mxCell>
        <mxCell id="inventory-category-note" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#263238;strokeColor=#8C9AA1;strokeWidth=1.2;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F0FA;align=left;fontSize=16;" value="标签定义&#xa;全部：当前背包内所有可收纳物品。&#xa;消耗品：恢复药剂、一次性效果物品等。&#xa;材料：采集物、食料、炼材、碎片等。&#xa;装备：可穿戴物品，保留单件独立属性。&#xa;任务：任务信物、凭证与剧情道具。" vertex="1">
          <mxGeometry height="184" width="510" x="40" y="210" as="geometry" />
        </mxCell>
        <mxCell id="inventory-grid-note" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#263238;strokeColor=#8C9AA1;strokeWidth=1.2;align=center;verticalAlign=middle;spacing=8;fillColor=#FFFFFF;align=left;fontSize=16;" value="格子与筛选&#xa;可堆叠物品显示数量；装备按独立实例显示。&#xa;格子显示品质、绑定、锁定与新获得标记。&#xa;搜索、分类与排序共同生效，切换后保留选择。&#xa;背包总容量与当前筛选数量分别计算。&#xa;未拥有的物品不混入列表。" vertex="1">
          <mxGeometry height="172" width="510" x="40" y="432" as="geometry" />
        </mxCell>
        <mxCell id="inventory-ownership-note" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#263238;strokeColor=#8C9AA1;strokeWidth=1.2;align=center;verticalAlign=middle;spacing=8;fillColor=#EAF4EC;align=left;fontSize=16;" value="蛊虫与材料边界&#xa;蛊虫本体统一在第 05 页「蛊」管理。&#xa;食料与炼蛊材料保存在背包，操作时扣取。&#xa;角色穿戴从背包选择装备，成功后同步占用。&#xa;任务道具保持任务绑定，不可出售或丢弃。&#xa;整理只调整排列，不自动消耗、合成或出售。" vertex="1">
          <mxGeometry height="172" width="510" x="40" y="640" as="geometry" />
        </mxCell>
        <mxCell id="inventory-capacity-note" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#263238;strokeColor=#8C9AA1;strokeWidth=1.2;align=center;verticalAlign=middle;spacing=8;fillColor=#F2F4F5;align=left;fontSize=16;" value="容量与空状态&#xa;无物品：展示当前分类为空及获取途径。&#xa;满包：说明无法收取的物品，并给出整理入口。&#xa;不存在的仓库或扩容能力不假定已开放。&#xa;批量处理只选择允许处理的物品。&#xa;关键操作有二次确认和明确数量。" vertex="1">
          <mxGeometry height="172" width="510" x="40" y="850" as="geometry" />
        </mxCell>
        <mxCell id="inventory-right-title" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#263238;strokeColor=#8C9AA1;strokeWidth=1.2;align=center;verticalAlign=middle;spacing=8;fillColor=#FFFFFF;strokeColor=none;fillColor=none;align=left;spacing=0;fontSize=22;" value="点选后的动作" vertex="1">
          <mxGeometry height="30" width="500" x="1260" y="160" as="geometry" />
        </mxCell>
        <mxCell id="inventory-choose-item" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#263238;strokeColor=#8C9AA1;strokeWidth=1.2;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F0FA;" value="分类 / 搜索 → 点击物品 → 查看详情" vertex="1">
          <mxGeometry height="62" width="500" x="1260" y="214" as="geometry" />
        </mxCell>
        <mxCell id="inventory-choose-action" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#263238;strokeColor=#8C9AA1;strokeWidth=1.2;align=center;verticalAlign=middle;spacing=8;fillColor=#FFFFFF;" value="显示允许的操作&#xa;消耗品：使用；装备：穿戴；材料：用途 / 获取&#xa;任务物品：查看任务；锁定物品禁止出售" vertex="1">
          <mxGeometry height="100" width="500" x="1260" y="320" as="geometry" />
        </mxCell>
        <mxCell id="inventory-confirm" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#263238;strokeColor=#8C9AA1;strokeWidth=1.2;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF6DA;" value="选择数量并确认&#xa;穿戴时显示属性与外观对比；出售提示回收量" vertex="1">
          <mxGeometry height="74" width="500" x="1260" y="464" as="geometry" />
        </mxCell>
        <mxCell id="inventory-receipt" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#263238;strokeColor=#8C9AA1;strokeWidth=1.2;align=center;verticalAlign=middle;spacing=8;fillColor=#EAF4EC;" value="等待结果 → 刷新数量、容量与角色属性&#xa;失败显示原因，保持物品选择" vertex="1">
          <mxGeometry height="74" width="500" x="1260" y="582" as="geometry" />
        </mxCell>
        <mxCell id="inventory-edge-1" edge="1" parent="1" source="inventory-choose-item" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#69818A;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="inventory-choose-action" value="查看">
