        </UserObject>
        <mxCell id="lobby-safe-bottom" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#263238;strokeColor=#84939B;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=8;fillColor=#F2F4F5;fontSize=11;strokeColor=none;" value="底部手势安全区" vertex="1">
          <mxGeometry height="18" width="516" x="562" y="1164" as="geometry" />
        </mxCell>
        <mxCell id="lobby-left-heading" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#263238;strokeColor=#84939B;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=8;fillColor=#FFFFFF;strokeColor=none;fillColor=none;align=left;spacing=0;fontSize=21;" value="信息与任务" vertex="1">
          <mxGeometry height="30" width="400" x="40" y="144" as="geometry" />
        </mxCell>
        <mxCell id="lobby-profile-notes" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#263238;strokeColor=#84939B;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F0FA;align=left;fontSize=16;" value="玩家主信息｜左上角&#xa;头像 → 角色详情、资质、流派与属性。&#xa;常驻昵称、转数小阶、生命与当前能量。&#xa;资质容量与当前真元余额分别显示。" vertex="1">
          <mxGeometry height="140" width="410" x="40" y="196" as="geometry" />
        </mxCell>
        <mxCell id="lobby-task-notes" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#263238;strokeColor=#84939B;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=8;fillColor=#FFFFFF;align=left;fontSize=16;" value="任务与队伍｜左侧&#xa;默认只追踪一条主任务，长文截断。&#xa;点任务 → 详情 → 前往 / 领取。&#xa;切换队伍页可组队、查看队友状态。&#xa;手动移动可随时中断自动前往。" vertex="1">
          <mxGeometry height="162" width="410" x="40" y="380" as="geometry" />
        </mxCell>
        <mxCell id="lobby-world-notes" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#263238;strokeColor=#84939B;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=8;fillColor=#F2F4F5;align=left;fontSize=16;" value="主画面｜中间&#xa;角色与目标区域不被常驻面板遮住。&#xa;靠近 NPC 后显示交互，点击再打开。&#xa;打开面板时屏蔽穿透点击。&#xa;多人世界继续运行，不因打开背包暂停。" vertex="1">
          <mxGeometry height="160" width="410" x="40" y="582" as="geometry" />
        </mxCell>
        <mxCell id="lobby-thumb-notes" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#263238;strokeColor=#84939B;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=8;fillColor=#FFFFFF;align=left;fontSize=16;" value="操作区｜下半屏&#xa;摇杆在左，情境交互在右。&#xa;聊天与六槽信息位于底栏上方。&#xa;底部入口建议至少 44 逻辑像素高；&#xa;适配刘海、胶囊与系统手势区。" vertex="1">
          <mxGeometry height="160" width="410" x="50" y="900" as="geometry" />
        </mxCell>
        <mxCell id="lobby-reference" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#263238;strokeColor=#84939B;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=8;fillColor=#FFFFFF;strokeColor=none;fillColor=none;align=left;spacing=0;fontSize=13;" value="参考方向：竖屏探索 RPG《剑与远征：启程》、&#xa;修炼题材《一念逍遥》；结合本项目玩法重新组织。" vertex="1">
          <mxGeometry height="58" width="460" x="40" y="1094" as="geometry" />
        </mxCell>
        <mxCell id="lobby-right-heading" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#263238;strokeColor=#84939B;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=8;fillColor=#FFFFFF;strokeColor=none;fillColor=none;align=left;spacing=0;fontSize=21;" value="便捷入口与显示规则" vertex="1">
          <mxGeometry height="30" width="410" x="1190" y="144" as="geometry" />
        </mxCell>
        <mxCell id="lobby-map-notes" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#263238;strokeColor=#84939B;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F0FA;align=left;fontSize=16;" value="地图与货币｜右上角 / 顶部&#xa;地图 → 区域目标、传送、请求换线。&#xa;分线由服务端确认；归属区独立显示。&#xa;元石、仙元石与战斗真元分别展示。&#xa;邮箱放常用位置，附件可领取时提示。" vertex="1">
          <mxGeometry height="160" width="410" x="1190" y="196" as="geometry" />
        </mxCell>
        <mxCell id="lobby-activity-notes" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#263238;strokeColor=#84939B;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=8;fillColor=#FFFFFF;align=left;fontSize=16;" value="活动与福利｜右侧&#xa;保留活动、福利、限时事件、坊市。&#xa;签到 / 七日目标收进福利页。&#xa;世界事件显示剩余时间与进入条件。&#xa;次要入口可折叠，避免挤占场景。" vertex="1">
          <mxGeometry height="160" width="410" x="1190" y="395" as="geometry" />
        </mxCell>
        <mxCell id="lobby-growth-notes" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#263238;strokeColor=#84939B;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=8;fillColor=#EAF4EC;align=left;fontSize=16;" value="成长与资产｜底部&#xa;角色属性 → 06；背包 → 07。&#xa;空窍 / 蛊虫 → 05：用、养、炼。&#xa;修炼道痕 → 08：元石 + 真元培养各领域。&#xa;杀招 → 09：每招六槽，最多八招。&#xa;空窍入口的切换动画保留，见第 05 页。" vertex="1">
          <mxGeometry height="160" width="410" x="1190" y="652" as="geometry" />
        </mxCell>
        <mxCell id="lobby-more-notes" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#263238;strokeColor=#84939B;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=8;fillColor=#F2F4F5;align=left;fontSize=16;" value="更多与提示｜控制入口数量&#xa;更多：图鉴 / 成就 / 设置 / 帮助。&#xa;未解锁功能显示条件，不留无响应按钮。&#xa;可领奖才显示红点；未读消息用数量。&#xa;普通反馈用轻提示，重要确认用弹窗。" vertex="1">
          <mxGeometry height="160" width="410" x="1190" y="879" as="geometry" />
        </mxCell>
        <mxCell id="lobby-features-link" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#263238;strokeColor=#84939B;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=8;fillColor=#FFFFFF;strokeColor=none;fillColor=none;align=left;spacing=0;fontSize=16;" value="入口的下一级页面与返回规则 → 第 04 页" vertex="1">
          <mxGeometry height="42" width="410" x="1190" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="sq3b_ruHAphVTDalSSW0-1" parent="1" style="whiteSpace=wrap;html=1;" value="下方为草稿" vertex="1">
          <mxGeometry height="60" width="344" x="16" y="1400" as="geometry" />
        </mxCell>
        <UserObject label="杀招" link="data:page/id,killer" id="sq3b_ruHAphVTDalSSW0-2">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#263238;strokeColor=#84939B;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F0FA;fontSize=17;" vertex="1">
            <mxGeometry height="54" width="96" x="982" y="1070" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;span style=&quot;color: rgb(38, 50, 56); font-family: &amp;quot;Microsoft YaHei&amp;quot;; font-size: 17px;&quot;&gt;真元实时显示/点击可进入蛊虫空窍界面&lt;/span&gt;" link="data:page/id,gu" id="o-aOFeaqdcoXkcDtVVdA-1">
          <mxCell parent="1" style="ellipse;whiteSpace=wrap;html=1;" vertex="1">
            <mxGeometry height="116" width="120" x="760" y="1000" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
