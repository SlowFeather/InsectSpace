        <UserObject link="data:page/id,gu" label="查看蛊虫" id="character-open-gu">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#263238;strokeColor=#8C9AA1;strokeWidth=1.2;align=center;verticalAlign=middle;spacing=8;fillColor=#EAF4EC;fontSize=17;" vertex="1">
