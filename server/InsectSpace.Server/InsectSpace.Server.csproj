<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../shared/com.insectspace.foundation/InsectSpace.Foundation.csproj" />
    <ProjectReference Include="../../shared/com.insectspace.simulation/InsectSpace.Simulation.csproj" />
    <ProjectReference Include="../../shared/com.insectspace.network/InsectSpace.Network.csproj" />
    <Reference Include="Framework.Core"><HintPath>../../vendor/dotnet/Framework.Core.dll</HintPath></Reference>
    <Reference Include="Framework.Network.Kcp"><HintPath>../../vendor/dotnet/Framework.Network.Kcp.dll</HintPath></Reference>
    <Reference Include="Kcp"><HintPath>../../vendor/dotnet/Kcp.dll</HintPath></Reference>
    <Compile Include="../Generated/Config/*.cs" Link="Config/%(Filename)%(Extension)" />
    <Compile Include="../../client/unity/InsectSpaceClient/Assets/InsectSpace/LubanRuntime/*.cs" Link="Luban/%(Filename)%(Extension)" />
    <None Include="../Generated/Data/*.bytes" Link="Data/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
