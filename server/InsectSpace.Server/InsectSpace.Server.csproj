    <Reference Include="Framework.Network.Kcp"><HintPath>../../vendor/dotnet/Framework.Network.Kcp.dll</HintPath></Reference>
    <Reference Include="Kcp"><HintPath>../../vendor/dotnet/Kcp.dll</HintPath></Reference>
